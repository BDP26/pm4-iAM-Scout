   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"83ca3ad6\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"# Player Rating Model Training\\n\\nThis notebook trains a machine learning model to predict player performance ratings.\\nIt uses Random Forest regression to learn from historical match statistics and player performance.\\nThe trained model is evaluated and saved for later use in production.\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"29dad3c7\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"Train the player rating model.\\n\",\n",
    "    \"\\n\",\n",
    "    \"This script trains a Random Forest regression pipeline for player match ratings,\\n\",\n",
    "    \"evaluates it with leakage-aware splits, and stores the final model as\\n\",\n",
    "    \"rating_model.pkl.\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"from typing import Iterable\\n\",\n",
    "    \"\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from sklearn.ensemble import RandomForestRegressor\\n\",\n",
    "    \"from sklearn.pipeline import Pipeline\\n\",\n",
    "    \"\\n\",\n",
    "    \"sys.path.append(str(Path.cwd().parent))\\n\",\n",
    "    \"\\n\",\n",
    "    \"from ml.toolkit.ml_utilities import (\\n\",\n",
    "    \"    build_preprocessor,\\n\",\n",
    "    \"    evaluate_model,\\n\",\n",
    "    \"    prepare_features_and_target,\\n\",\n",
    "    \"    print_evaluation,\\n\",\n",
    "    \"    save_model,\\n\",\n",
    "    \"    split_data_by_group,\\n\",\n",
    "    \"    split_data_randomly,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"DATA_PATH = Path(\\\"../data/transform/pro/stats_with_rating.csv\\\")\\n\",\n",
    "    \"MODEL_PATH = Path(\\\"rating_model.pkl\\\")\\n\",\n",
    "    \"TARGET_COLUMN = \\\"rating\\\"\\n\",\n",
    "    \"PLAYER_GROUP_COLUMN = \\\"player_id\\\"\\n\",\n",
    "    \"MATCH_GROUP_COLUMN = \\\"match_id\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"METADATA_COLUMNS = [\\n\",\n",
    "    \"    \\\"player_id\\\",\\n\",\n",
    "    \"    \\\"match_id\\\",\\n\",\n",
    "    \"    \\\"club_id\\\",\\n\",\n",
    "    \"    \\\"player_name\\\",\\n\",\n",
    "    \"    \\\"date\\\",\\n\",\n",
    "    \"    \\\"home_club_id\\\",\\n\",\n",
    "    \"    \\\"away_club_id\\\",\\n\",\n",
    "    \"    \\\"home_goals\\\",\\n\",\n",
    "    \"    \\\"away_goals\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"NUMERIC_COLUMNS = [\\n\",\n",
    "    \"    \\\"goals\\\",\\n\",\n",
    "    \"    \\\"assists\\\",\\n\",\n",
    "    \"    \\\"minutes\\\",\\n\",\n",
    "    \"    \\\"on_min\\\",\\n\",\n",
    "    \"    \\\"off_min\\\",\\n\",\n",
    "    \"    \\\"team_goals\\\",\\n\",\n",
    "    \"    \\\"team_conceded\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"CATEGORICAL_COLUMNS = [\\n\",\n",
    "    \"    \\\"position\\\",\\n\",\n",
    "    \"    \\\"result\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"BOOLEAN_COLUMNS = [\\n\",\n",
    "    \"    \\\"yellow\\\",\\n\",\n",
    "    \"    \\\"yellow_red\\\",\\n\",\n",
    "    \"    \\\"red\\\",\\n\",\n",
    "    \"    \\\"start_eleven\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"FEATURE_COLUMNS = NUMERIC_COLUMNS + BOOLEAN_COLUMNS + CATEGORICAL_COLUMNS\\n\",\n",
    "    \"\\n\",\n",
    "    \"MODEL_PARAMETERS = {\\n\",\n",
    "    \"    \\\"n_estimators\\\": 1000,\\n\",\n",
    "    \"    \\\"max_depth\\\": 20,\\n\",\n",
    "    \"    \\\"min_samples_split\\\": 2,\\n\",\n",
    "    \"    \\\"min_samples_leaf\\\": 1,\\n\",\n",
    "    \"    \\\"random_state\\\": 42,\\n\",\n",
    "    \"    \\\"n_jobs\\\": -1,\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def validate_columns(dataframe: pd.DataFrame, required_columns: Iterable[str]) -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Raise an error when required columns are missing from a dataframe.\\\"\\\"\\\"\\n\",\n",
    "    \"    missing_columns = sorted(set(required_columns) - set(dataframe.columns))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if missing_columns:\\n\",\n",
    "    \"        raise ValueError(f\\\"Missing required columns: {missing_columns}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_training_data(input_path: Path) -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Load the training dataset from disk.\\\"\\\"\\\"\\n\",\n",
    "    \"    if not input_path.exists():\\n\",\n",
    "    \"        raise FileNotFoundError(f\\\"Training data not found: {input_path}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return pd.read_csv(input_path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def build_rating_model() -> Pipeline:\\n\",\n",
    "    \"    \\\"\\\"\\\"Build the rating prediction pipeline.\\\"\\\"\\\"\\n\",\n",
    "    \"    preprocessor = build_preprocessor(\\n\",\n",
    "    \"        numeric_columns=NUMERIC_COLUMNS,\\n\",\n",
    "    \"        categorical_columns=CATEGORICAL_COLUMNS,\\n\",\n",
    "    \"        boolean_columns=BOOLEAN_COLUMNS,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return Pipeline(\\n\",\n",
    "    \"        steps=[\\n\",\n",
    "    \"            (\\\"preprocessing\\\", preprocessor),\\n\",\n",
    "    \"            (\\\"model\\\", RandomForestRegressor(**MODEL_PARAMETERS)),\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def prepare_training_data(dataframe: pd.DataFrame) -> tuple[pd.DataFrame, pd.Series]:\\n\",\n",
    "    \"    \\\"\\\"\\\"Prepare rating features and target values.\\\"\\\"\\\"\\n\",\n",
    "    \"    required_columns = FEATURE_COLUMNS + METADATA_COLUMNS + [TARGET_COLUMN]\\n\",\n",
    "    \"    validate_columns(dataframe, required_columns)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    features, target = prepare_features_and_target(\\n\",\n",
    "    \"        dataframe=dataframe,\\n\",\n",
    "    \"        target_column=TARGET_COLUMN,\\n\",\n",
    "    \"        columns_to_drop=METADATA_COLUMNS,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return features[FEATURE_COLUMNS], target\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def evaluate_split(\\n\",\n",
    "    \"    model: Pipeline,\\n\",\n",
    "    \"    features_train: pd.DataFrame,\\n\",\n",
    "    \"    features_test: pd.DataFrame,\\n\",\n",
    "    \"    target_train: pd.Series,\\n\",\n",
    "    \"    target_test: pd.Series,\\n\",\n",
    "    \"    split_name: str,\\n\",\n",
    "    \") -> dict[str, float]:\\n\",\n",
    "    \"    \\\"\\\"\\\"Train and evaluate a model on one split.\\\"\\\"\\\"\\n\",\n",
    "    \"    model.fit(features_train, target_train)\\n\",\n",
    "    \"    predictions = model.predict(features_test)\\n\",\n",
    "    \"    metrics = evaluate_model(target_test, predictions)\\n\",\n",
    "    \"    print_evaluation(metrics, split_name)\\n\",\n",
    "    \"    return metrics\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def evaluate_model_splits(\\n\",\n",
    "    \"    dataframe: pd.DataFrame,\\n\",\n",
    "    \"    features: pd.DataFrame,\\n\",\n",
    "    \"    target: pd.Series,\\n\",\n",
    "    \") -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Evaluate the rating model with random, player, and match splits.\\\"\\\"\\\"\\n\",\n",
    "    \"    random_split = split_data_randomly(features, target)\\n\",\n",
    "    \"    player_split = split_data_by_group(\\n\",\n",
    "    \"        dataframe=dataframe,\\n\",\n",
    "    \"        features=features,\\n\",\n",
    "    \"        target=target,\\n\",\n",
    "    \"        group_column=PLAYER_GROUP_COLUMN,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    match_split = split_data_by_group(\\n\",\n",
    "    \"        dataframe=dataframe,\\n\",\n",
    "    \"        features=features,\\n\",\n",
    "    \"        target=target,\\n\",\n",
    "    \"        group_column=MATCH_GROUP_COLUMN,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    evaluate_split(build_rating_model(), *random_split, split_name=\\\"Random Split\\\")\\n\",\n",
    "    \"    evaluate_split(build_rating_model(), *player_split, split_name=\\\"Player Split\\\")\\n\",\n",
    "    \"    match_metrics = evaluate_split(\\n\",\n",
    "    \"        build_rating_model(),\\n\",\n",
    "    \"        *match_split,\\n\",\n",
    "    \"        split_name=\\\"Match Split\\\",\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    print(f\\\"\\\\nR2 Match Split: {match_metrics['r2_score']:.4f}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def train_final_model(features: pd.DataFrame, target: pd.Series) -> Pipeline:\\n\",\n",
    "    \"    \\\"\\\"\\\"Train the final rating model on all available training data.\\\"\\\"\\\"\\n\",\n",
    "    \"    model = build_rating_model()\\n\",\n",
    "    \"    model.fit(features, target)\\n\",\n",
    "    \"    return model\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def main() -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Run model training, evaluation, and model export.\\\"\\\"\\\"\\n\",\n",
    "    \"    dataframe = load_training_data(DATA_PATH)\\n\",\n",
    "    \"    features, target = prepare_training_data(dataframe)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    evaluate_model_splits(dataframe, features, target)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    final_model = train_final_model(features, target)\\n\",\n",
    "    \"    save_model(final_model, str(MODEL_PATH))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"if __name__ == \\\"__main__\\\":\\n\",\n",
    "    \"    main()\\n\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
    " \"metadata\": {},\n",
    " \"nbformat\": 4,\n",
    " \"nbformat_minor\": 5\n",
    "}\n",
    "\n"
   ],
