   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"a8d90bdf\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"# Apply Rating Model\\n\\nThis notebook demonstrates how to apply the trained rating model to generate predictions\\nfor new player match data. It loads the pre-trained model and applies it to create ratings.\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"b94ab365\",\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"Apply the trained player rating model to transformed player statistics.\\n\",\n",
    "    \"\\n\",\n",
    "    \"This script enriches player statistics with position and match context, predicts\\n\",\n",
    "    \"ratings with rating_model.pkl, and writes the updated player_stats.csv file.\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"from typing import Iterable\\n\",\n",
    "    \"\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"\\n\",\n",
    "    \"sys.path.append(str(Path.cwd().parent))\\n\",\n",
    "    \"\\n\",\n",
    "    \"from toolkit.ml_utilities import load_model\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"PLAYER_STATS_PATH = Path(\\\"../data/transform/player_stats.csv\\\")\\n\",\n",
    "    \"PLAYERS_PATH = Path(\\\"../data/transform/players.csv\\\")\\n\",\n",
    "    \"MATCHES_PATH = Path(\\\"../data/transform/matches.csv\\\")\\n\",\n",
    "    \"MODEL_PATH = Path(\\\"rating_model.pkl\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"OUTPUT_PATH = PLAYER_STATS_PATH\\n\",\n",
    "    \"\\n\",\n",
    "    \"NUMERIC_COLUMNS = [\\n\",\n",
    "    \"    \\\"goals\\\",\\n\",\n",
    "    \"    \\\"assists\\\",\\n\",\n",
    "    \"    \\\"minutes\\\",\\n\",\n",
    "    \"    \\\"on_min\\\",\\n\",\n",
    "    \"    \\\"off_min\\\",\\n\",\n",
    "    \"    \\\"team_goals\\\",\\n\",\n",
    "    \"    \\\"team_conceded\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"CATEGORICAL_COLUMNS = [\\n\",\n",
    "    \"    \\\"position\\\",\\n\",\n",
    "    \"    \\\"result\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"BOOLEAN_COLUMNS = [\\n\",\n",
    "    \"    \\\"yellow\\\",\\n\",\n",
    "    \"    \\\"yellow_red\\\",\\n\",\n",
    "    \"    \\\"red\\\",\\n\",\n",
    "    \"    \\\"start_eleven\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"FEATURE_COLUMNS = NUMERIC_COLUMNS + BOOLEAN_COLUMNS + CATEGORICAL_COLUMNS\\n\",\n",
    "    \"\\n\",\n",
    "    \"PLAYER_COLUMNS = [\\n\",\n",
    "    \"    \\\"player_id\\\",\\n\",\n",
    "    \"    \\\"position\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"MATCH_COLUMNS = [\\n\",\n",
    "    \"    \\\"match_id\\\",\\n\",\n",
    "    \"    \\\"date\\\",\\n\",\n",
    "    \"    \\\"home_club_id\\\",\\n\",\n",
    "    \"    \\\"away_club_id\\\",\\n\",\n",
    "    \"    \\\"home_goals\\\",\\n\",\n",
    "    \"    \\\"away_goals\\\",\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def validate_columns(dataframe: pd.DataFrame, required_columns: Iterable[str]) -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Raise an error when required columns are missing from a dataframe.\\\"\\\"\\\"\\n\",\n",
    "    \"    missing_columns = sorted(set(required_columns) - set(dataframe.columns))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if missing_columns:\\n\",\n",
    "    \"        raise ValueError(f\\\"Missing required columns: {missing_columns}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_csv(input_path: Path, required_columns: Iterable[str]) -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Load a CSV file and validate its required columns.\\\"\\\"\\\"\\n\",\n",
    "    \"    if not input_path.exists():\\n\",\n",
    "    \"        raise FileNotFoundError(f\\\"File not found: {input_path}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    dataframe = pd.read_csv(input_path)\\n\",\n",
    "    \"    validate_columns(dataframe, required_columns)\\n\",\n",
    "    \"    return dataframe\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def add_player_positions(\\n\",\n",
    "    \"    player_stats: pd.DataFrame,\\n\",\n",
    "    \"    players: pd.DataFrame,\\n\",\n",
    "    \") -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Add player positions to player statistics.\\\"\\\"\\\"\\n\",\n",
    "    \"    if \\\"position\\\" in player_stats.columns:\\n\",\n",
    "    \"        return player_stats.copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return player_stats.merge(\\n\",\n",
    "    \"        players[PLAYER_COLUMNS],\\n\",\n",
    "    \"        on=\\\"player_id\\\",\\n\",\n",
    "    \"        how=\\\"left\\\",\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def add_match_context(\\n\",\n",
    "    \"    player_stats: pd.DataFrame,\\n\",\n",
    "    \"    matches: pd.DataFrame,\\n\",\n",
    "    \") -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Add match context columns to player statistics.\\\"\\\"\\\"\\n\",\n",
    "    \"    return player_stats.merge(\\n\",\n",
    "    \"        matches[MATCH_COLUMNS],\\n\",\n",
    "    \"        on=\\\"match_id\\\",\\n\",\n",
    "    \"        how=\\\"left\\\",\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def add_match_result(dataframe: pd.DataFrame) -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Add the match result from the perspective of the player's club.\\\"\\\"\\\"\\n\",\n",
    "    \"    result = dataframe.copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    is_home_team = result[\\\"club_id\\\"] == result[\\\"home_club_id\\\"]\\n\",\n",
    "    \"    is_away_team = result[\\\"club_id\\\"] == result[\\\"away_club_id\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result[\\\"result\\\"] = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result.loc[\\n\",\n",
    "    \"        is_home_team & (result[\\\"home_goals\\\"] > result[\\\"away_goals\\\"]),\\n\",\n",
    "    \"        \\\"result\\\",\\n\",\n",
    "    \"    ] = \\\"win\\\"\\n\",\n",
    "    \"    result.loc[\\n\",\n",
    "    \"        is_home_team & (result[\\\"home_goals\\\"] < result[\\\"away_goals\\\"]),\\n\",\n",
    "    \"        \\\"result\\\",\\n\",\n",
    "    \"    ] = \\\"loss\\\"\\n\",\n",
    "    \"    result.loc[\\n\",\n",
    "    \"        is_home_team & (result[\\\"home_goals\\\"] == result[\\\"away_goals\\\"]),\\n\",\n",
    "    \"        \\\"result\\\",\\n\",\n",
    "    \"    ] = \\\"draw\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result.loc[\\n\",\n",
    "    \"        is_away_team & (result[\\\"away_goals\\\"] > result[\\\"home_goals\\\"]),\\n\",\n",
    "    \"        \\\"result\\\",\\n\",\n",
    "    \"    ] = \\\"win\\\"\\n\",\n",
    "    \"    result.loc[\\n\",\n",
    "    \"        is_away_team & (result[\\\"away_goals\\\"] < result[\\\"home_goals\\\"]),\\n\",\n",
    "    \"        \\\"result\\\",\\n\",\n",
    "    \"    ] = \\\"loss\\\"\\n\",\n",
    "    \"    result.loc[\\n\",\n",
    "    \"        is_away_team & (result[\\\"away_goals\\\"] == result[\\\"home_goals\\\"]),\\n\",\n",
    "    \"        \\\"result\\\",\\n\",\n",
    "    \"    ] = \\\"draw\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return result\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def predict_ratings(\\n\",\n",
    "    \"    dataframe: pd.DataFrame,\\n\",\n",
    "    \"    model,\\n\",\n",
    "    \") -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Predict and append player ratings.\\\"\\\"\\\"\\n\",\n",
    "    \"    validate_columns(dataframe, FEATURE_COLUMNS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    result = dataframe.copy()\\n\",\n",
    "    \"    result[\\\"rating\\\"] = model.predict(result[FEATURE_COLUMNS]).round(1)\\n\",\n",
    "    \"    return result\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def select_output_columns(\\n\",\n",
    "    \"    dataframe: pd.DataFrame,\\n\",\n",
    "    \"    original_columns: list[str],\\n\",\n",
    "    \") -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Keep original player statistics columns and the predicted rating column.\\\"\\\"\\\"\\n\",\n",
    "    \"    output_columns = list(original_columns)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if \\\"rating\\\" not in output_columns:\\n\",\n",
    "    \"        output_columns.append(\\\"rating\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return dataframe[output_columns]\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def main() -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Run rating prediction and update the player statistics CSV file.\\\"\\\"\\\"\\n\",\n",
    "    \"    player_stats = load_csv(\\n\",\n",
    "    \"        PLAYER_STATS_PATH,\\n\",\n",
    "    \"        required_columns=[\\\"player_id\\\", \\\"match_id\\\", \\\"club_id\\\"],\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    players = load_csv(PLAYERS_PATH, required_columns=PLAYER_COLUMNS)\\n\",\n",
    "    \"    matches = load_csv(MATCHES_PATH, required_columns=MATCH_COLUMNS)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    original_columns = list(player_stats.columns)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    enriched_stats = add_player_positions(player_stats, players)\\n\",\n",
    "    \"    enriched_stats = add_match_context(enriched_stats, matches)\\n\",\n",
    "    \"    enriched_stats = add_match_result(enriched_stats)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    model = load_model(str(MODEL_PATH))\\n\",\n",
    "    \"    predicted_stats = predict_ratings(enriched_stats, model)\\n\",\n",
    "    \"    output_stats = select_output_columns(predicted_stats, original_columns)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    output_stats.to_csv(OUTPUT_PATH, index=False)\\n\",\n",
    "    \"    print(f\\\"[INFO] Ratings written to: {OUTPUT_PATH}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"if __name__ == \\\"__main__\\\":\\n\",\n",
    "    \"    main()\\n\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
    " \"metadata\": {},\n",
    " \"nbformat\": 4,\n",
    " \"nbformat_minor\": 5\n",
    "}\n"
   ],
