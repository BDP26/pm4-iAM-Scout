   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"notebook-docstring\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"# Player Recommender Model Training\\n\\nThis notebook trains machine learning models to recommend similar players based on performance profiles. It creates position-specific recommenders for defense, goalkeeper, midfield, and offense positions.\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"Train one player recommender model per position group.\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"from sklearn.ensemble import RandomForestRegressor\\n\",\n",
    "    \"from sklearn.pipeline import Pipeline\\n\",\n",
    "    \"\\n\",\n",
    "    \"CURRENT_DIR = Path(__file__).resolve().parent\\n\",\n",
    "    \"PROJECT_ROOT = CURRENT_DIR.parent\\n\",\n",
    "    \"sys.path.append(str(PROJECT_ROOT))\\n\",\n",
    "    \"\\n\",\n",
    "    \"from ml.toolkit.ml_utilities import (\\n\",\n",
    "    \"    POSITION_GROUPS,\\n\",\n",
    "    \"    RECOMMENDER_CATEGORICAL_COLUMNS,\\n\",\n",
    "    \"    RECOMMENDER_TARGET_COLUMN,\\n\",\n",
    "    \"    build_preprocessor,\\n\",\n",
    "    \"    evaluate_model,\\n\",\n",
    "    \"    get_recommender_feature_columns,\\n\",\n",
    "    \"    get_recommender_numeric_columns,\\n\",\n",
    "    \"    prepare_features_and_target,\\n\",\n",
    "    \"    print_evaluation,\\n\",\n",
    "    \"    save_model,\\n\",\n",
    "    \"    split_data_by_group,\\n\",\n",
    "    \"    split_data_randomly,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"DATASET_PATH = CURRENT_DIR / \\\"recommender_model_dataset.csv\\\"\\n\",\n",
    "    \"MODEL_PATH_TEMPLATE = CURRENT_DIR / \\\"recommender_model_{position_group}.pkl\\\"\\n\",\n",
    "    \"PLAYER_ID_COLUMN = \\\"player_id\\\"\\n\",\n",
    "    \"POSITION_GROUP_COLUMN = \\\"position_group\\\"\\n\",\n",
    "    \"RANDOM_STATE = 42\\n\",\n",
    "    \"TEST_SIZE = 0.2\\n\",\n",
    "    \"MIN_GROUP_ROWS_FOR_TEST = 8\\n\",\n",
    "    \"MIN_GROUP_PLAYERS_FOR_GROUP_SPLIT = 3\\n\",\n",
    "    \"\\n\",\n",
    "    \"MODEL_PARAMETERS = {\\n\",\n",
    "    \"    \\\"n_estimators\\\": 500,\\n\",\n",
    "    \"    \\\"max_depth\\\": 10,\\n\",\n",
    "    \"    \\\"min_samples_split\\\": 2,\\n\",\n",
    "    \"    \\\"min_samples_leaf\\\": 1,\\n\",\n",
    "    \"    \\\"random_state\\\": RANDOM_STATE,\\n\",\n",
    "    \"    \\\"n_jobs\\\": -1,\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_training_dataset(dataset_path: Path) -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Load the recommender training dataset.\\\"\\\"\\\"\\n\",\n",
    "    \"    if not dataset_path.exists():\\n\",\n",
    "    \"        raise FileNotFoundError(f\\\"Training dataset not found: {dataset_path}\\\")\\n\",\n",
    "    \"    dataset = pd.read_csv(dataset_path)\\n\",\n",
    "    \"    required_columns = {PLAYER_ID_COLUMN, POSITION_GROUP_COLUMN, RECOMMENDER_TARGET_COLUMN}\\n\",\n",
    "    \"    missing_columns = required_columns.difference(dataset.columns)\\n\",\n",
    "    \"    if missing_columns:\\n\",\n",
    "    \"        raise ValueError(f\\\"Missing required columns in training dataset: {sorted(missing_columns)}\\\")\\n\",\n",
    "    \"    return dataset\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def build_model_pipeline(\\n\",\n",
    "    \"    numeric_columns: list[str],\\n\",\n",
    "    \"    categorical_columns: list[str],\\n\",\n",
    "    \") -> Pipeline:\\n\",\n",
    "    \"    \\\"\\\"\\\"Build the recommender model pipeline.\\\"\\\"\\\"\\n\",\n",
    "    \"    preprocessor = build_preprocessor(\\n\",\n",
    "    \"        numeric_columns=numeric_columns,\\n\",\n",
    "    \"        categorical_columns=categorical_columns,\\n\",\n",
    "    \"        boolean_columns=[],\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return Pipeline(\\n\",\n",
    "    \"        steps=[\\n\",\n",
    "    \"            (\\\"preprocessing\\\", preprocessor),\\n\",\n",
    "    \"            (\\\"model\\\", RandomForestRegressor(**MODEL_PARAMETERS)),\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def split_group_data(\\n\",\n",
    "    \"    group_dataset: pd.DataFrame,\\n\",\n",
    "    \"    features: pd.DataFrame,\\n\",\n",
    "    \"    target: pd.Series,\\n\",\n",
    "    \") -> tuple[pd.DataFrame, pd.DataFrame, pd.Series, pd.Series]:\\n\",\n",
    "    \"    \\\"\\\"\\\"Split a position-group dataset by player where possible.\\\"\\\"\\\"\\n\",\n",
    "    \"    enough_rows = len(group_dataset) >= MIN_GROUP_ROWS_FOR_TEST\\n\",\n",
    "    \"    enough_players = group_dataset[PLAYER_ID_COLUMN].nunique() >= MIN_GROUP_PLAYERS_FOR_GROUP_SPLIT\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if enough_rows and enough_players:\\n\",\n",
    "    \"        return split_data_by_group(\\n\",\n",
    "    \"            dataframe=group_dataset,\\n\",\n",
    "    \"            features=features,\\n\",\n",
    "    \"            target=target,\\n\",\n",
    "    \"            group_column=PLAYER_ID_COLUMN,\\n\",\n",
    "    \"            test_size=TEST_SIZE,\\n\",\n",
    "    \"            random_state=RANDOM_STATE,\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return split_data_randomly(\\n\",\n",
    "    \"        features=features,\\n\",\n",
    "    \"        target=target,\\n\",\n",
    "    \"        test_size=TEST_SIZE,\\n\",\n",
    "    \"        random_state=RANDOM_STATE,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def train_position_group_model(\\n\",\n",
    "    \"    dataset: pd.DataFrame,\\n\",\n",
    "    \"    position_group: str,\\n\",\n",
    "    \") -> dict[str, object] | None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Train and save a recommender model for one position group.\\\"\\\"\\\"\\n\",\n",
    "    \"    group_dataset = dataset[dataset[POSITION_GROUP_COLUMN] == position_group].copy()\\n\",\n",
    "    \"    group_dataset = group_dataset.dropna(subset=[RECOMMENDER_TARGET_COLUMN])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if group_dataset.empty:\\n\",\n",
    "    \"        print(f\\\"Skipped {position_group}: no training rows available\\\")\\n\",\n",
    "    \"        return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    feature_columns = get_recommender_feature_columns(group_dataset)\\n\",\n",
    "    \"    numeric_columns = get_recommender_numeric_columns(group_dataset)\\n\",\n",
    "    \"    categorical_columns = [\\n\",\n",
    "    \"        column for column in RECOMMENDER_CATEGORICAL_COLUMNS if column in feature_columns\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    features, target = prepare_features_and_target(\\n\",\n",
    "    \"        dataframe=group_dataset,\\n\",\n",
    "    \"        target_column=RECOMMENDER_TARGET_COLUMN,\\n\",\n",
    "    \"        columns_to_drop=[PLAYER_ID_COLUMN, POSITION_GROUP_COLUMN],\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    features_train, features_test, target_train, target_test = split_group_data(\\n\",\n",
    "    \"        group_dataset=group_dataset,\\n\",\n",
    "    \"        features=features,\\n\",\n",
    "    \"        target=target,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    model = build_model_pipeline(\\n\",\n",
    "    \"        numeric_columns=numeric_columns,\\n\",\n",
    "    \"        categorical_columns=categorical_columns,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    model.fit(features_train, target_train)\\n\",\n",
    "    \"    predictions = model.predict(features_test)\\n\",\n",
    "    \"    metrics = evaluate_model(target_test, predictions)\\n\",\n",
    "    \"    print_evaluation(metrics, model_name=f\\\"Recommender {position_group}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    model.feature_columns_ = list(features.columns)\\n\",\n",
    "    \"    model.numeric_columns_ = numeric_columns\\n\",\n",
    "    \"    model.categorical_columns_ = categorical_columns\\n\",\n",
    "    \"    model.position_group_ = position_group\\n\",\n",
    "    \"\\n\",\n",
    "    \"    output_path = Path(str(MODEL_PATH_TEMPLATE).format(position_group=position_group))\\n\",\n",
    "    \"    save_model(model, output_path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return {\\n\",\n",
    "    \"        \\\"position_group\\\": position_group,\\n\",\n",
    "    \"        \\\"rows\\\": len(group_dataset),\\n\",\n",
    "    \"        \\\"players\\\": group_dataset[PLAYER_ID_COLUMN].nunique(),\\n\",\n",
    "    \"        \\\"mean_absolute_error\\\": metrics[\\\"mean_absolute_error\\\"],\\n\",\n",
    "    \"        \\\"root_mean_squared_error\\\": metrics[\\\"root_mean_squared_error\\\"],\\n\",\n",
    "    \"        \\\"r2_score\\\": metrics[\\\"r2_score\\\"],\\n\",\n",
    "    \"        \\\"model_path\\\": str(output_path),\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def train_all_position_group_models(dataset: pd.DataFrame) -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Train recommender models for all configured position groups.\\\"\\\"\\\"\\n\",\n",
    "    \"    results = []\\n\",\n",
    "    \"    for position_group in POSITION_GROUPS:\\n\",\n",
    "    \"        result = train_position_group_model(dataset, position_group)\\n\",\n",
    "    \"        if result is not None:\\n\",\n",
    "    \"            results.append(result)\\n\",\n",
    "    \"    return pd.DataFrame(results)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def main() -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Run recommender model training.\\\"\\\"\\\"\\n\",\n",
    "    \"    dataset = load_training_dataset(DATASET_PATH)\\n\",\n",
    "    \"    results = train_all_position_group_models(dataset)\\n\",\n",
    "    \"    if not results.empty:\\n\",\n",
    "    \"        print(\\\"\\\\nTraining summary:\\\")\\n\",\n",
    "    \"        print(results.to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"if __name__ == \\\"__main__\\\":\\n\",\n",
    "    \"    main()\\n\"\n",
    "   ],\n",
    "   \"id\": \"99a8a7e4bac4975a\"\n",
    "  }\n",
    " ],\n",
