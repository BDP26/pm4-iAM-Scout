   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"notebook-docstring\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"# Feature Engineering\\n\\nThis notebook performs feature engineering and data preparation for training the recommender models.\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"Build the training dataset for the player recommender model.\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"\\n\",\n",
    "    \"CURRENT_DIR = Path(__file__).resolve().parent\\n\",\n",
    "    \"PROJECT_ROOT = CURRENT_DIR.parent\\n\",\n",
    "    \"sys.path.append(str(PROJECT_ROOT))\\n\",\n",
    "    \"\\n\",\n",
    "    \"from ml.toolkit.ml_utilities import build_recommender_season_features, build_recommender_training_dataset\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"SOURCE_DATA_DIR = PROJECT_ROOT / \\\"data\\\" / \\\"scrape\\\" / \\\"amateur\\\"\\n\",\n",
    "    \"OUTPUT_PATH = CURRENT_DIR / \\\"recommender_model_dataset.csv\\\"\\n\",\n",
    "    \"FIRST_TRAINING_SEASON = 2020\\n\",\n",
    "    \"LAST_TRAINING_SEASON = 2024\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_source_tables(data_dir: Path) -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:\\n\",\n",
    "    \"    \\\"\\\"\\\"Load source tables required for recommender feature engineering.\\\"\\\"\\\"\\n\",\n",
    "    \"    required_files = {\\n\",\n",
    "    \"        \\\"player_stats\\\": data_dir / \\\"player_stats.csv\\\",\\n\",\n",
    "    \"        \\\"matches\\\": data_dir / \\\"matches.csv\\\",\\n\",\n",
    "    \"        \\\"players\\\": data_dir / \\\"players.csv\\\",\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    missing_files = [str(path) for path in required_files.values() if not path.exists()]\\n\",\n",
    "    \"    if missing_files:\\n\",\n",
    "    \"        raise FileNotFoundError(f\\\"Missing source files: {missing_files}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    player_stats = pd.read_csv(required_files[\\\"player_stats\\\"])\\n\",\n",
    "    \"    matches = pd.read_csv(required_files[\\\"matches\\\"])\\n\",\n",
    "    \"    players = pd.read_csv(required_files[\\\"players\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return player_stats, matches, players\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def build_dataset(\\n\",\n",
    "    \"    player_stats: pd.DataFrame,\\n\",\n",
    "    \"    matches: pd.DataFrame,\\n\",\n",
    "    \"    players: pd.DataFrame,\\n\",\n",
    "    \") -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Create the supervised recommender dataset from raw source tables.\\\"\\\"\\\"\\n\",\n",
    "    \"    season_features = build_recommender_season_features(player_stats, matches, players)\\n\",\n",
    "    \"    dataset = build_recommender_training_dataset(\\n\",\n",
    "    \"        season_features,\\n\",\n",
    "    \"        first_training_season=FIRST_TRAINING_SEASON,\\n\",\n",
    "    \"        last_training_season=LAST_TRAINING_SEASON,\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    return dataset\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def save_dataset(dataset: pd.DataFrame, output_path: Path) -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Save the recommender dataset to disk.\\\"\\\"\\\"\\n\",\n",
    "    \"    output_path.parent.mkdir(parents=True, exist_ok=True)\\n\",\n",
    "    \"    dataset.to_csv(output_path, index=False)\\n\",\n",
    "    \"    print(f\\\"Saved recommender dataset: {output_path}\\\")\\n\",\n",
    "    \"    print(f\\\"Rows: {len(dataset)}\\\")\\n\",\n",
    "    \"    print(f\\\"Players: {dataset['player_id'].nunique()}\\\")\\n\",\n",
    "    \"    print(dataset[\\\"season\\\"].value_counts().sort_index())\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def main() -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Run the recommender feature engineering pipeline.\\\"\\\"\\\"\\n\",\n",
    "    \"    player_stats, matches, players = load_source_tables(SOURCE_DATA_DIR)\\n\",\n",
    "    \"    dataset = build_dataset(player_stats, matches, players)\\n\",\n",
    "    \"    save_dataset(dataset, OUTPUT_PATH)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"if __name__ == \\\"__main__\\\":\\n\",\n",
    "    \"    main()\\n\"\n",
    "   ],\n",
    "   \"id\": \"9df5dc2172c11e95\"\n",
    "  }\n",
