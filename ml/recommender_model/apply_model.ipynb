   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"notebook-docstring\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"# Apply Recommender Model\\n\\nThis notebook demonstrates how to apply the trained recommender models to find similar players for any given player.\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-05-13T09:08:01.748802Z\",\n",
    "     \"start_time\": \"2026-05-13T09:08:01.110774Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"Apply trained recommender models to players from the current season.\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"\\n\",\n",
    "    \"CURRENT_DIR = Path(__file__).resolve().parent\\n\",\n",
    "    \"PROJECT_ROOT = CURRENT_DIR.parent\\n\",\n",
    "    \"sys.path.append(str(PROJECT_ROOT))\\n\",\n",
    "    \"\\n\",\n",
    "    \"from ml.toolkit.ml_utilities import (\\n\",\n",
    "    \"    POSITION_GROUPS,\\n\",\n",
    "    \"    align_prediction_features,\\n\",\n",
    "    \"    build_recommender_season_features,\\n\",\n",
    "    \"    get_recommender_feature_columns,\\n\",\n",
    "    \"    load_model,\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"DATA_DIR = PROJECT_ROOT / \\\"data\\\" / \\\"transform\\\"\\n\",\n",
    "    \"PLAYER_STATS_PATH = DATA_DIR / \\\"player_stats.csv\\\"\\n\",\n",
    "    \"MATCHES_PATH = DATA_DIR / \\\"matches.csv\\\"\\n\",\n",
    "    \"PLAYERS_PATH = DATA_DIR / \\\"players.csv\\\"\\n\",\n",
    "    \"MODEL_PATH_TEMPLATE = CURRENT_DIR / \\\"recommender_model_{position_group}.pkl\\\"\\n\",\n",
    "    \"PREDICTION_SEASON = 2025\\n\",\n",
    "    \"PREDICTION_COLUMN = \\\"prediction\\\"\\n\",\n",
    "    \"PLAYER_ID_COLUMN = \\\"player_id\\\"\\n\",\n",
    "    \"POSITION_GROUP_COLUMN = \\\"position_group\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_prediction_tables() -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:\\n\",\n",
    "    \"    \\\"\\\"\\\"Load transformed tables required for recommender inference.\\\"\\\"\\\"\\n\",\n",
    "    \"    required_files = [PLAYER_STATS_PATH, MATCHES_PATH, PLAYERS_PATH]\\n\",\n",
    "    \"    missing_files = [str(path) for path in required_files if not path.exists()]\\n\",\n",
    "    \"    if missing_files:\\n\",\n",
    "    \"        raise FileNotFoundError(f\\\"Missing prediction files: {missing_files}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    player_stats = pd.read_csv(PLAYER_STATS_PATH)\\n\",\n",
    "    \"    matches = pd.read_csv(MATCHES_PATH)\\n\",\n",
    "    \"    players = pd.read_csv(PLAYERS_PATH)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return player_stats, matches, players\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_position_group_model(position_group: str):\\n\",\n",
    "    \"    \\\"\\\"\\\"Load a recommender model for one position group if it exists.\\\"\\\"\\\"\\n\",\n",
    "    \"    model_path = Path(str(MODEL_PATH_TEMPLATE).format(position_group=position_group))\\n\",\n",
    "    \"    if not model_path.exists():\\n\",\n",
    "    \"        print(f\\\"Skipped {position_group}: model file not found at {model_path}\\\")\\n\",\n",
    "    \"        return None\\n\",\n",
    "    \"    return load_model(model_path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def predict_position_group(\\n\",\n",
    "    \"    prediction_dataset: pd.DataFrame,\\n\",\n",
    "    \"    position_group: str,\\n\",\n",
    "    \") -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Predict next-season ratings for one position group.\\\"\\\"\\\"\\n\",\n",
    "    \"    model = load_position_group_model(position_group)\\n\",\n",
    "    \"    if model is None:\\n\",\n",
    "    \"        return pd.DataFrame(columns=[PLAYER_ID_COLUMN, PREDICTION_COLUMN])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    group_dataset = prediction_dataset[\\n\",\n",
    "    \"        prediction_dataset[POSITION_GROUP_COLUMN] == position_group\\n\",\n",
    "    \"    ].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if group_dataset.empty:\\n\",\n",
    "    \"        return pd.DataFrame(columns=[PLAYER_ID_COLUMN, PREDICTION_COLUMN])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    feature_columns = getattr(model, \\\"feature_columns_\\\", get_recommender_feature_columns(group_dataset))\\n\",\n",
    "    \"    features = align_prediction_features(group_dataset, feature_columns)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    group_predictions = group_dataset[[PLAYER_ID_COLUMN]].copy()\\n\",\n",
    "    \"    group_predictions[PREDICTION_COLUMN] = model.predict(features).round(2)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return group_predictions\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def predict_current_season_players(\\n\",\n",
    "    \"    player_stats: pd.DataFrame,\\n\",\n",
    "    \"    matches: pd.DataFrame,\\n\",\n",
    "    \"    players: pd.DataFrame,\\n\",\n",
    "    \") -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Predict next-season ratings for players who played in the configured season.\\\"\\\"\\\"\\n\",\n",
    "    \"    season_features = build_recommender_season_features(player_stats, matches, players)\\n\",\n",
    "    \"    prediction_dataset = season_features[season_features[\\\"season\\\"] == PREDICTION_SEASON].copy()\\n\",\n",
    "    \"    prediction_dataset = prediction_dataset[prediction_dataset[POSITION_GROUP_COLUMN].notna()].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    prediction_frames = []\\n\",\n",
    "    \"    for position_group in POSITION_GROUPS:\\n\",\n",
    "    \"        prediction_frames.append(predict_position_group(prediction_dataset, position_group))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if not prediction_frames:\\n\",\n",
    "    \"        return pd.DataFrame(columns=[PLAYER_ID_COLUMN, PREDICTION_COLUMN])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    predictions = pd.concat(prediction_frames, ignore_index=True)\\n\",\n",
    "    \"    predictions = predictions.dropna(subset=[PREDICTION_COLUMN])\\n\",\n",
    "    \"    return predictions.drop_duplicates(subset=[PLAYER_ID_COLUMN], keep=\\\"last\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def update_players_with_predictions(\\n\",\n",
    "    \"    players: pd.DataFrame,\\n\",\n",
    "    \"    predictions: pd.DataFrame,\\n\",\n",
    "    \") -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Add predictions to the players table while keeping non-playing players as missing values.\\\"\\\"\\\"\\n\",\n",
    "    \"    result = players.drop(columns=[PREDICTION_COLUMN], errors=\\\"ignore\\\").copy()\\n\",\n",
    "    \"    result = result.merge(predictions, on=PLAYER_ID_COLUMN, how=\\\"left\\\")\\n\",\n",
    "    \"    result[PREDICTION_COLUMN] = pd.to_numeric(result[PREDICTION_COLUMN], errors=\\\"coerce\\\")\\n\",\n",
    "    \"    return result\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def print_top_predictions(players: pd.DataFrame) -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Print the five players with the highest predictions.\\\"\\\"\\\"\\n\",\n",
    "    \"    name_columns = [column for column in [\\\"player_name\\\", \\\"name\\\"] if column in players.columns]\\n\",\n",
    "    \"    display_columns = [PLAYER_ID_COLUMN] + name_columns + [PREDICTION_COLUMN]\\n\",\n",
    "    \"    top_players = players.dropna(subset=[PREDICTION_COLUMN]).sort_values(PREDICTION_COLUMN, ascending=False)\\n\",\n",
    "    \"    print(\\\"\\\\nTop 5 predicted players:\\\")\\n\",\n",
    "    \"    print(top_players[display_columns].head(5).to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def save_players(players: pd.DataFrame) -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Save the players table with the prediction column.\\\"\\\"\\\"\\n\",\n",
    "    \"    players.to_csv(PLAYERS_PATH, index=False)\\n\",\n",
    "    \"    predicted_count = players[PREDICTION_COLUMN].notna().sum()\\n\",\n",
    "    \"    print(f\\\"Saved players with predictions: {PLAYERS_PATH}\\\")\\n\",\n",
    "    \"    print(f\\\"Predicted players: {predicted_count}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def main() -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Run recommender inference for the current season.\\\"\\\"\\\"\\n\",\n",
    "    \"    player_stats, matches, players = load_prediction_tables()\\n\",\n",
    "    \"    predictions = predict_current_season_players(player_stats, matches, players)\\n\",\n",
    "    \"    updated_players = update_players_with_predictions(players, predictions)\\n\",\n",
    "    \"    save_players(updated_players)\\n\",\n",
    "    \"    print_top_predictions(updated_players)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"if __name__ == \\\"__main__\\\":\\n\",\n",
    "    \"    main()\\n\"\n",
    "   ],\n",
