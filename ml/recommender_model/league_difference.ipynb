   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"notebook-docstring\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": \"# League Difference Analysis\\n\\nThis notebook analyzes performance differences between leagues to adjust player ratings based on league-specific factors.\"\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"Analyze rating differences between 1. Liga and Promotion League by position group.\\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"\\n\",\n",
    "    \"CURRENT_DIR = Path(__file__).resolve().parent\\n\",\n",
    "    \"PROJECT_ROOT = CURRENT_DIR.parent\\n\",\n",
    "    \"sys.path.append(str(PROJECT_ROOT))\\n\",\n",
    "    \"\\n\",\n",
    "    \"from ml.toolkit.ml_utilities import POSITION_TO_GROUP, normalize_league, parse_season_start_year\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"DATA_DIR = PROJECT_ROOT / \\\"data\\\" / \\\"transform\\\"\\n\",\n",
    "    \"MIN_MATCHES_PER_SEASON = 5\\n\",\n",
    "    \"PAIRS_OUTPUT_PATH = CURRENT_DIR / \\\"league_difference_pairs.csv\\\"\\n\",\n",
    "    \"SUMMARY_OUTPUT_PATH = CURRENT_DIR / \\\"league_difference_summary.csv\\\"\\n\",\n",
    "    \"STABLE_SUMMARY_OUTPUT_PATH = CURRENT_DIR / \\\"league_difference_stable_position_summary.csv\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def load_transform_tables(data_dir: Path) -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:\\n\",\n",
    "    \"    \\\"\\\"\\\"Load transformed tables required for league difference analysis.\\\"\\\"\\\"\\n\",\n",
    "    \"    required_files = {\\n\",\n",
    "    \"        \\\"player_stats\\\": data_dir / \\\"player_stats.csv\\\",\\n\",\n",
    "    \"        \\\"players\\\": data_dir / \\\"players.csv\\\",\\n\",\n",
    "    \"        \\\"matches\\\": data_dir / \\\"matches.csv\\\",\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    missing_files = [str(path) for path in required_files.values() if not path.exists()]\\n\",\n",
    "    \"    if missing_files:\\n\",\n",
    "    \"        raise FileNotFoundError(f\\\"Missing transformed files: {missing_files}\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    player_stats = pd.read_csv(required_files[\\\"player_stats\\\"])\\n\",\n",
    "    \"    players = pd.read_csv(required_files[\\\"players\\\"])\\n\",\n",
    "    \"    matches = pd.read_csv(required_files[\\\"matches\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return player_stats, players, matches\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def build_match_rating_dataset(\\n\",\n",
    "    \"    player_stats: pd.DataFrame,\\n\",\n",
    "    \"    players: pd.DataFrame,\\n\",\n",
    "    \"    matches: pd.DataFrame,\\n\",\n",
    "    \") -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Create a match-level rating dataset with league and position context.\\\"\\\"\\\"\\n\",\n",
    "    \"    dataset = (\\n\",\n",
    "    \"        player_stats.merge(\\n\",\n",
    "    \"            matches[[\\\"match_id\\\", \\\"season\\\", \\\"league\\\", \\\"date\\\"]],\\n\",\n",
    "    \"            on=\\\"match_id\\\",\\n\",\n",
    "    \"            how=\\\"left\\\",\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        .merge(\\n\",\n",
    "    \"            players[[\\\"player_id\\\", \\\"player_name\\\", \\\"position\\\"]],\\n\",\n",
    "    \"            on=\\\"player_id\\\",\\n\",\n",
    "    \"            how=\\\"left\\\",\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    dataset[\\\"league_group\\\"] = dataset[\\\"league\\\"].map(normalize_league)\\n\",\n",
    "    \"    dataset[\\\"season_start_year\\\"] = dataset[\\\"season\\\"].map(parse_season_start_year)\\n\",\n",
    "    \"    dataset[\\\"position_group\\\"] = dataset[\\\"position\\\"].map(POSITION_TO_GROUP)\\n\",\n",
    "    \"    dataset[\\\"rating\\\"] = pd.to_numeric(dataset[\\\"rating\\\"], errors=\\\"coerce\\\")\\n\",\n",
    "    \"    dataset[\\\"minutes\\\"] = pd.to_numeric(dataset[\\\"minutes\\\"], errors=\\\"coerce\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return dataset[\\n\",\n",
    "    \"        dataset[\\\"league_group\\\"].isin([\\\"1. Liga\\\", \\\"Promotion League\\\"])\\n\",\n",
    "    \"        & dataset[\\\"rating\\\"].notna()\\n\",\n",
    "    \"        & dataset[\\\"season_start_year\\\"].notna()\\n\",\n",
    "    \"        & dataset[\\\"position_group\\\"].notna()\\n\",\n",
    "    \"        & (dataset[\\\"minutes\\\"] > 0)\\n\",\n",
    "    \"    ].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def aggregate_player_season_ratings(dataset: pd.DataFrame) -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Aggregate match ratings to player-season ratings.\\\"\\\"\\\"\\n\",\n",
    "    \"    player_season_ratings = (\\n\",\n",
    "    \"        dataset.groupby(\\n\",\n",
    "    \"            [\\n\",\n",
    "    \"                \\\"player_id\\\",\\n\",\n",
    "    \"                \\\"player_name\\\",\\n\",\n",
    "    \"                \\\"season\\\",\\n\",\n",
    "    \"                \\\"season_start_year\\\",\\n\",\n",
    "    \"                \\\"league_group\\\",\\n\",\n",
    "    \"                \\\"position\\\",\\n\",\n",
    "    \"                \\\"position_group\\\",\\n\",\n",
    "    \"            ],\\n\",\n",
    "    \"            as_index=False,\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        .agg(\\n\",\n",
    "    \"            avg_rating=(\\\"rating\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            matches_played=(\\\"match_id\\\", \\\"nunique\\\"),\\n\",\n",
    "    \"            minutes_total=(\\\"minutes\\\", \\\"sum\\\"),\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return player_season_ratings[player_season_ratings[\\\"matches_played\\\"] >= MIN_MATCHES_PER_SEASON].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def build_league_transition_pairs(player_season_ratings: pd.DataFrame) -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Build player-season pairs across 1. Liga and Promotion League.\\\"\\\"\\\"\\n\",\n",
    "    \"    one_liga = player_season_ratings[player_season_ratings[\\\"league_group\\\"] == \\\"1. Liga\\\"].copy()\\n\",\n",
    "    \"    promotion_league = player_season_ratings[\\n\",\n",
    "    \"        player_season_ratings[\\\"league_group\\\"] == \\\"Promotion League\\\"\\n\",\n",
    "    \"    ].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    one_liga = one_liga.rename(\\n\",\n",
    "    \"        columns={\\n\",\n",
    "    \"            \\\"season\\\": \\\"season_first_league\\\",\\n\",\n",
    "    \"            \\\"season_start_year\\\": \\\"season_year_first_league\\\",\\n\",\n",
    "    \"            \\\"avg_rating\\\": \\\"avg_rating_first_league\\\",\\n\",\n",
    "    \"            \\\"matches_played\\\": \\\"matches_first_league\\\",\\n\",\n",
    "    \"            \\\"minutes_total\\\": \\\"minutes_first_league\\\",\\n\",\n",
    "    \"            \\\"position\\\": \\\"position_first_league\\\",\\n\",\n",
    "    \"            \\\"position_group\\\": \\\"position_group_first_league\\\",\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    promotion_league = promotion_league.rename(\\n\",\n",
    "    \"        columns={\\n\",\n",
    "    \"            \\\"season\\\": \\\"season_promotion_league\\\",\\n\",\n",
    "    \"            \\\"season_start_year\\\": \\\"season_year_promotion_league\\\",\\n\",\n",
    "    \"            \\\"avg_rating\\\": \\\"avg_rating_promotion_league\\\",\\n\",\n",
    "    \"            \\\"matches_played\\\": \\\"matches_promotion_league\\\",\\n\",\n",
    "    \"            \\\"minutes_total\\\": \\\"minutes_promotion_league\\\",\\n\",\n",
    "    \"            \\\"position\\\": \\\"position_promotion_league\\\",\\n\",\n",
    "    \"            \\\"position_group\\\": \\\"position_group_promotion_league\\\",\\n\",\n",
    "    \"        }\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    pairs = one_liga.merge(\\n\",\n",
    "    \"        promotion_league,\\n\",\n",
    "    \"        on=[\\\"player_id\\\", \\\"player_name\\\"],\\n\",\n",
    "    \"        how=\\\"inner\\\",\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    pairs = pairs[\\n\",\n",
    "    \"        (pairs[\\\"season_year_promotion_league\\\"] - pairs[\\\"season_year_first_league\\\"]).abs() == 1\\n\",\n",
    "    \"    ].copy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    pairs[\\\"rating_diff_promotion_minus_first_league\\\"] = (\\n\",\n",
    "    \"        pairs[\\\"avg_rating_promotion_league\\\"] - pairs[\\\"avg_rating_first_league\\\"]\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    pairs[\\\"transition_direction\\\"] = np.where(\\n\",\n",
    "    \"        pairs[\\\"season_year_promotion_league\\\"] > pairs[\\\"season_year_first_league\\\"],\\n\",\n",
    "    \"        \\\"1. Liga -> Promotion League\\\",\\n\",\n",
    "    \"        \\\"Promotion League -> 1. Liga\\\",\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    pairs[\\\"same_position_group\\\"] = (\\n\",\n",
    "    \"        pairs[\\\"position_group_first_league\\\"] == pairs[\\\"position_group_promotion_league\\\"]\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return pairs\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def summarize_pairs(pairs: pd.DataFrame) -> pd.DataFrame:\\n\",\n",
    "    \"    \\\"\\\"\\\"Summarize league transition pairs by first-league position group.\\\"\\\"\\\"\\n\",\n",
    "    \"    return (\\n\",\n",
    "    \"        pairs.groupby(\\\"position_group_first_league\\\", as_index=False)\\n\",\n",
    "    \"        .agg(\\n\",\n",
    "    \"            mean_diff=(\\\"rating_diff_promotion_minus_first_league\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            median_diff=(\\\"rating_diff_promotion_minus_first_league\\\", \\\"median\\\"),\\n\",\n",
    "    \"            std_diff=(\\\"rating_diff_promotion_minus_first_league\\\", \\\"std\\\"),\\n\",\n",
    "    \"            pair_count=(\\\"rating_diff_promotion_minus_first_league\\\", \\\"count\\\"),\\n\",\n",
    "    \"            mean_rating_first_league=(\\\"avg_rating_first_league\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            mean_rating_promotion_league=(\\\"avg_rating_promotion_league\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            mean_matches_first_league=(\\\"matches_first_league\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            mean_matches_promotion_league=(\\\"matches_promotion_league\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            mean_minutes_first_league=(\\\"minutes_first_league\\\", \\\"mean\\\"),\\n\",\n",
    "    \"            mean_minutes_promotion_league=(\\\"minutes_promotion_league\\\", \\\"mean\\\"),\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"        .sort_values(\\\"mean_diff\\\", ascending=False)\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def save_outputs(pairs: pd.DataFrame, summary: pd.DataFrame, stable_summary: pd.DataFrame) -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Save league difference analysis outputs to CSV files.\\\"\\\"\\\"\\n\",\n",
    "    \"    pairs.to_csv(PAIRS_OUTPUT_PATH, index=False)\\n\",\n",
    "    \"    summary.to_csv(SUMMARY_OUTPUT_PATH, index=False)\\n\",\n",
    "    \"    stable_summary.to_csv(STABLE_SUMMARY_OUTPUT_PATH, index=False)\\n\",\n",
    "    \"    print(f\\\"Saved pairs: {PAIRS_OUTPUT_PATH}\\\")\\n\",\n",
    "    \"    print(f\\\"Saved summary: {SUMMARY_OUTPUT_PATH}\\\")\\n\",\n",
    "    \"    print(f\\\"Saved stable-position summary: {STABLE_SUMMARY_OUTPUT_PATH}\\\")\\n\",\n",
    "    \"    print(summary[[\\\"position_group_first_league\\\", \\\"median_diff\\\", \\\"pair_count\\\"]].to_string(index=False))\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def main() -> None:\\n\",\n",
    "    \"    \\\"\\\"\\\"Run the league difference analysis.\\\"\\\"\\\"\\n\",\n",
    "    \"    player_stats, players, matches = load_transform_tables(DATA_DIR)\\n\",\n",
    "    \"    match_rating_dataset = build_match_rating_dataset(player_stats, players, matches)\\n\",\n",
    "    \"    player_season_ratings = aggregate_player_season_ratings(match_rating_dataset)\\n\",\n",
    "    \"    pairs = build_league_transition_pairs(player_season_ratings)\\n\",\n",
    "    \"    summary = summarize_pairs(pairs)\\n\",\n",
    "    \"    stable_summary = summarize_pairs(pairs[pairs[\\\"same_position_group\\\"]].copy())\\n\",\n",
    "    \"    save_outputs(pairs, summary, stable_summary)\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"if __name__ == \\\"__main__\\\":\\n\",\n",
    "    \"    main()\\n\"\n",
    "   ],\n",
    "   \"id\": \"f1fafd6c085f9bd6\"\n",
    "  }\n",
